{
  "name": "ting-baby-memories-backend",
  "version": "1.0.0",
  "description": "ting baby memories server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js --env development",
    "prod": "node src/server.js --env production",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,json}\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuChao66/Ting-Baby-Memories-backend.git"
  },
  "keywords": [
    "node",
    "express",
    "nodemon",
    "mongoose",
    "morgan",
    "cors",
    "dotenv"
  ],
  "author": "suchao",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SuChao66/Ting-Baby-Memories-backend/issues"
  },
  "homepage": "https://github.com/SuChao66/Ting-Baby-Memories-backend#readme",
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
