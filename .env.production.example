# 服务端口
PORT=3000

# MongoDB 连接地址
MONGO_URI=mongodb://username:password@host:27017/tingbabymemories?authSource=admin

# 运行环境
NODE_ENV=production

# CORS 允许的来源
CORS_ORIGINS=*

# JWT 密钥
JWT_SECRET=your-jwt-secret

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 应用密钥（加密解密）
ENCRYPT_SECRET_KEY=your-encrypt-secret-key

# 腾讯云 COS 配置
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-cos-bucket
COS_REGION=ap-shanghai
COS_CDN_DOMAIN=
